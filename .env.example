# Создай read-only токен в Т-Инвестициях. Не включай доступ к торгам.
TINVEST_TOKEN=YOUR_READ_ONLY_T_INVEST_TOKEN
# ID счета: python -m invest_blog.cli accounts
TINVEST_ACCOUNT_IDS=
TELEGRAM_BOT_TOKEN=
# Узнать свой ID: /whoami у бота
TELEGRAM_CHAT_ID=
TIMEZONE=Europe/Moscow
WEEKLY_TIME=10:00
MONTHLY_TIME=11:00
PLAN_TIME=10:00
PAPER_TIME=10:00
GLOSSARY_TIME=10:00
DB_PATH=./data/drafts.sqlite3
CBR_EVENTS_PATH=./data/cbr_events.json
STARTUP_CATCHUP=true
LOG_LEVEL=INFO

# Только после проверки бота — публичный канал или -100...; бот должен быть администратором
TELEGRAM_CHANNEL_ID=
# Ежедневный сбор снимков (21:00 по TIMEZONE), пока выключено
AUTO_SNAPSHOT=false
# Индикативные ориентиры, не торговые сигналы
BOND_TARGET=0.60
MAX_POSITION_WEIGHT=0.15

# v1.5.1: поиск новых облигаций — при работающем боте каждые 4 часа.
# Финам: публичный HTML-календарь; при блокировке/изменении HTML источник отобразит ошибку.
PLACEMENTS_FINAM_ENABLED=true
# Дополнительный разрешённый JSON-фид (опционально; HTTPS), с полем placements: [...].
PLACEMENTS_FEED_URL=

# Разбор выбранного портфеля каждые 3 дня (при работающем боте).
IIS_REVIEW_ENABLED=true
IIS_REVIEW_INTERVAL_DAYS=3
# При одном TINVEST_ACCOUNT_IDS выбирается автоматически; при нескольких укажи один.
IIS_REVIEW_ACCOUNT_ID=


# Investment Telegram news (legacy TECH_ names retained): one post at :00 and :30; end hour is exclusive.
# Keep disabled until bot/channel rights and translation model have been checked.
TECH_TELEGRAM_CHANNEL_ID=
TECH_TG_AUTO_PUBLISH=false
TECH_TG_MODE=direct
TECH_TG_RUNNER=worker
TECH_TG_START_HOUR=9
TECH_TG_END_HOUR=23
TECH_TG_DAILY_LIMIT=28
TECH_TG_MAX_AGE_HOURS=24

# PAPER futures lab. Separate paid API access; never enables real broker orders.
TRADING_AI_PROVIDER=xai
TRADING_AI_MODEL=grok-4.7
XAI_API_KEY=
# Optional generic key for another supported provider; overrides XAI_API_KEY.
TRADING_AI_API_KEY=

# Grok chat connector: LOCAL credential, no paid xAI API required.
# Generate once with .\hub grok-key. Never use a broker key here.
GROK_CONNECTOR_TOKEN=
# Optional public HTTPS tunnel base URL, without /mcp or secrets.
GROK_CONNECTOR_PUBLIC_URL=

# Enable only after approved Walt cloud transfer.
WALT_CLOUD_TRADING_ENABLED=false
WALT_TELEGRAM_CLOUD_ENABLED=false
