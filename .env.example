# Создай read-only токен в Т-Инвестициях. Не включай доступ к торгам.
TINVEST_TOKEN=YOUR_READ_ONLY_T_INVEST_TOKEN
# ID счета: python -m invest_blog.cli accounts
TINVEST_ACCOUNT_IDS=
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Узнать свой ID: /whoami у бота
TELEGRAM_CHAT_ID=
TIMEZONE=Europe/Moscow
WEEKLY_TIME=10:00
MONTHLY_TIME=11:00
PLAN_TIME=10:00
PAPER_TIME=10:00
GLOSSARY_TIME=10:00
DB_PATH=./data/drafts.sqlite3
CBR_EVENTS_PATH=./data/cbr_events.json
STARTUP_CATCHUP=true
LOG_LEVEL=INFO

# Только после проверки бота — публичный канал или -100...; бот должен быть администратором
TELEGRAM_CHANNEL_ID=
# Ежедневный сбор снимков (21:00 по TIMEZONE), пока выключено
AUTO_SNAPSHOT=false
# Индикативные ориентиры, не торговые сигналы
BOND_TARGET=0.60
MAX_POSITION_WEIGHT=0.15

# v1.5.1: поиск новых облигаций — при работающем боте каждые 4 часа.
# Финам: публичный HTML-календарь; при блокировке/изменении HTML источник отобразит ошибку.
PLACEMENTS_FINAM_ENABLED=true
# Дополнительный разрешённый JSON-фид (опционально; HTTPS), с полем placements: [...].
PLACEMENTS_FEED_URL=

# Разбор выбранного портфеля каждые 3 дня (при работающем боте).
IIS_REVIEW_ENABLED=true
IIS_REVIEW_INTERVAL_DAYS=3
# При одном TINVEST_ACCOUNT_IDS выбирается автоматически; при нескольких укажи один.
IIS_REVIEW_ACCOUNT_ID=

